<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wid_dem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wid_nen_dem"
    android:orientation="vertical"
    android:padding="10dp">

    <ImageView
        android:id="@+id/wid_dem_mark"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="start"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_mark_cam" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/wid_dem_lua"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_lua_cam" />

        <TextView
            android:id="@+id/wid_dem_so"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="12"
            android:textColor="@color/trang"
            android:textSize="28sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/wid_dem_habit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="3/5"
        android:textColor="@color/lua"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/wid_dem_kcal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="2250 kcal"
        android:textColor="@color/lua"
        android:textSize="12sp" />
</LinearLayout>
