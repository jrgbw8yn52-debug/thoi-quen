<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wid_l_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:orientation="vertical"
    android:padding="0dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="19"
        android:background="@android:color/transparent" />

    <LinearLayout
        android:id="@+id/wid_l_dai"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="62"
        android:background="@drawable/wid_nen"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="6dp">

        <ImageView
            android:id="@+id/wid_l_mark"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:layout_marginEnd="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_mark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wid_l_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Thứ Tư 2/9 · 3/5"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_l_kcal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="none"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:text=" · 2425/2600"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/wid_l_nhan_f"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:text="@string/focus_nhan"
                android:textColor="@color/muc_toi"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wid_f1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wid_f1_gio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="8:00 SA"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_f1_ten"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Viết bài"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_f1_xong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wid_nut_xong"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="@string/xong"
                    android:textColor="@color/cam"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wid_f2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wid_f2_gio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_f2_ten"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="T7 19/9 Party · còn 2 ngày"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_f2_xong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wid_nut_xong"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="@string/xong"
                    android:textColor="@color/cam"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/wid_het_f"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/het_focus"
                android:textColor="@color/muc_toi"
                android:textSize="11sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/wid_l_nhan_v"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:paddingTop="2dp"
                android:text="@string/viec_nhan"
                android:textColor="@color/muc_toi"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/wid_h1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wid_h1_gio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="6:00 SA"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_h1_ten"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Dậy sớm"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_h1_xong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wid_nut_xong"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="@string/xong"
                    android:textColor="@color/cam"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/wid_h2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/wid_h2_gio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="8:00 SA"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_h2_ten"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:includeFontPadding="false"
                    android:maxLines="1"
                    android:text="Tập"
                    android:textColor="@color/muc_toi"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/wid_h2_xong"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/wid_nut_xong"
                    android:includeFontPadding="false"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:text="@string/xong"
                    android:textColor="@color/cam"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/wid_het_v"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="@string/het_viec"
                android:textColor="@color/muc_toi"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical|end"
            android:orientation="horizontal"
            android:paddingStart="6dp">

            <ImageView
                android:id="@+id/wid_l_lua"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/widget_lua" />

            <TextView
                android:id="@+id/wid_l_so"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="12"
                android:textColor="@color/muc_toi"
                android:textSize="27sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="19"
        android:background="@android:color/transparent" />
</LinearLayout>
